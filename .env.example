# Copy this file to .env at the repo root and fill in the values.
# .env is ignored by git. Never commit real secrets.
# In production, the same names are stored as GitHub Actions secrets and Cloudflare secrets.

# --- Database (Neon) ---------------------------------------------------------
# Pooled connection, for app code
DATABASE_URL=
# Direct connection, for migrations and Python pipeline jobs
DATABASE_URL_UNPOOLED=
NEON_PROJECT_ID=
# Local stand-in for Hyperdrive during `npm run dev` and `npm run preview`. Use the direct URL.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# --- Cloudflare --------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
# API token for GitHub Actions deploys and for Python jobs writing to R2
CLOUDFLARE_API_TOKEN=
# R2 access key for the Python jobs (Cloudflare dashboard > R2 > Manage API tokens)
R2_BUCKET_RAW=hockey-intel-raw
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Set to 1 in GitHub Actions so a missing R2 setup stops the job instead of skipping the archive
ARCHIVE_REQUIRED=

# --- Phase 1: sentiment collectors -------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Example: python:hockey-intel-hub:v0.1 (by /u/yourname)
REDDIT_USER_AGENT=
# Your Bluesky handle and an app password (Settings > Privacy and security > App passwords)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
YOUTUBE_API_KEY=

# --- Phase 3: HockeyStatCards email ingestion --------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_HSC_LABEL=

# --- Claude API (contract news now; sentiment scoring in Phase 4) ------------
ANTHROPIC_API_KEY=
# Optional: model and effort for the daily contract news job (defaults: claude-opus-5-5, medium)
CONTRACTS_MODEL=
CONTRACTS_EFFORT=

# --- Phase 6: auth, billing, email -------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=
RESEND_API_KEY=
EMAIL_FROM=
# Paid pages stay open to everyone until this is "on" (switch on once sign-up and billing work).
ACCESS_GATING=
# Labels shown on the pricing page, for example "$24 per year" (prices themselves live in Stripe).
PRICE_LABEL_ANNUAL=
PRICE_LABEL_MONTHLY=
# "on" adds Stripe Tax to Checkout (turn on before going live).
STRIPE_TAX=
# Public address for links Stripe sends people back to (defaults to the request's own address).
SITE_URL=
# Address shown on the contact page; left blank until a PuckSleuth address exists.
CONTACT_EMAIL=

# Optional: model for play style write-ups (default claude-haiku-4-5)
PLAY_STYLE_MODEL=

# Needed only if your Anthropic API key is not tied to a workspace (Console > Settings > Workspaces)
ANTHROPIC_WORKSPACE_ID=
