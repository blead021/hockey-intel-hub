# Copy this file to .env at the repo root and fill in the values.
# .env is ignored by git. Never commit real secrets.
# In production, the same names are stored as GitHub Actions secrets and Cloudflare secrets.

# --- Database (Neon) ---------------------------------------------------------
# Pooled connection, for app code
DATABASE_URL=
# Direct connection, for migrations and Python pipeline jobs
DATABASE_URL_UNPOOLED=
NEON_PROJECT_ID=
# Local stand-in for Hyperdrive during `npm run dev` and `npm run preview`. Use the direct URL.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# --- Cloudflare --------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
# API token for GitHub Actions deploys and for Python jobs writing to R2
CLOUDFLARE_API_TOKEN=
R2_BUCKET_RAW=hockey-intel-raw
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Phase 1: sentiment collectors -------------------------------------------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
YOUTUBE_API_KEY=

# --- Phase 3: HockeyStatCards email ingestion --------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_HSC_LABEL=

# --- Phase 3 and 4: Claude API -----------------------------------------------
ANTHROPIC_API_KEY=

# --- Phase 6: auth, billing, email -------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=
RESEND_API_KEY=
EMAIL_FROM=
